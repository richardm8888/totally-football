---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description, includeDiscoverMore, includeJoinTheSquad, hideHeader = false, hideFooter = false } = Astro.props;
---


<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>		
        {!hideHeader && <Header />}
		<main class={hideHeader ? 'no-header' : ''}>
            <slot />
            {!hideFooter && <Footer includeDiscoverMore={includeDiscoverMore} includeJoinTheSquad={includeJoinTheSquad} />}
		</main>

		<script>
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
			}, { threshold: 0.1 });
			document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
		</script>
		
	</body>
</html>

<style>
    body {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    main {
        width: 100%;
        max-width: 1300px;
        padding-top: 100px;
    }
    main.no-header { padding-top: 0; }

	@media (max-width: 799px) {
		main {
			padding-top: 60px;
		}
	}
</style>
