---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import KickstarterWords from '../assets/ks-word.png';
import { kickstarterLink } from '../consts';

const { title, description, image, type, noindex, includeDiscoverMore, includeJoinTheSquad, hideHeader = false, hideFooter = false } = Astro.props;
---


<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} type={type} noindex={noindex} />
		<slot name="head" />
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MXQSJWNW"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		 
        {!hideHeader && <Header />}
		<main class={hideHeader ? 'no-header' : ''}>
            <slot />
            {!hideFooter && <Footer includeDiscoverMore={includeDiscoverMore} includeJoinTheSquad={includeJoinTheSquad} />}
		</main>

		<div id="ks-banner">
			<a target="_blank" href={kickstarterLink('website_banner')} data-ks-location="banner">
				Follow us on <Image src={KickstarterWords} alt="Kickstarter Banner" />
			</a>
		</div>

		<!-- Inline and straight after the banner, so it is tucked before first paint and never flashes. -->
		<script is:inline>
			(function () {
				var banner = document.getElementById('ks-banner');
				var heroLink = document.querySelector('a[data-ks-location="hero"]');
				if (!banner || !heroLink || !('IntersectionObserver' in window)) return;

				banner.classList.add('tucked');
				new IntersectionObserver(function (entries) {
					banner.classList.toggle('tucked', entries[0].isIntersecting);
				}).observe(heroLink);
			})();
		</script>

		<script>
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
			}, { threshold: 0.1 });
			document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
		</script>
		
	</body>
</html>

<style>
    body {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    main {
        width: 100%;
        max-width: 1300px;
        padding-top: 100px;
    }
    main.no-header { padding-top: 0; }

	@media (max-width: 799px) {
		main {
			padding-top: 60px;
		}
	}
</style>
