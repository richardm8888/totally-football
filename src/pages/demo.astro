---
import Main from '../layouts/Main.astro';

// The demo is the Totally Football app's web build in demo mode, published to
// public/play by `npm run web-demo` in the totally-football-app repo. It asks this
// page to show the mailing-list form at half-time, before a second match and to
// unlock Chaos Cards, and unlocks when the form succeeds.
const SIGNUP_FORM = 'q1gvNS';
---
<style>
  #play-frame {
    position: fixed;
    top: 100px;
    bottom: 60px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    background: var(--navy-dark);
  }
  #play-frame iframe {
    width: 100%;
    max-width: 560px;
    height: 100%;
    border: 0;
    background: var(--navy-dark);
  }
  @media (max-width: 799px) {
    #play-frame { top: 60px; }
  }
  @media (max-width: 768px) {
    #play-frame { bottom: 52px; }
  }

  #signup {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(8, 12, 18, 0.85);
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  #signup.show { display: flex; }
  #signup-modal {
    position: relative;
    width: 100%;
    max-width: 420px;
    max-height: 100%;
    overflow-y: auto;
    background: var(--navy);
    border: 2px solid var(--lime);
    border-radius: 16px;
    padding: 26px 20px 20px;
    text-align: center;
  }
  #signup-modal .eyebrow {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lime);
  }
  #signup-modal h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.4rem;
    letter-spacing: 0.04em;
    line-height: 1;
    margin: 6px 0 10px;
  }
  #signup-modal p { color: var(--off-white); line-height: 1.5; margin-bottom: 14px; }
  #signup-close {
    position: absolute;
    top: 8px;
    right: 12px;
    background: none;
    border: 0;
    color: var(--text-muted);
    font-size: 28px;
    cursor: pointer;
  }
  #signup-done { display: none; margin-top: 12px; }
  #signup-done.show { display: block; }
  #signup-done button { width: 100%; }
</style>

<Main
  title="Free Football Board Game Demo | Play Totally Football"
  description="Play a free demo of Totally Football in your browser. Take on the computer, win duels from the build-up to the final third, and score."
  includeDiscoverMore={false}
  includeJoinTheSquad={false}
  hideFooter={true}
>
  <div id="play-frame">
    <iframe id="play" title="Totally Football demo" allow="autoplay"></iframe>
  </div>

  <div id="signup" role="dialog" aria-modal="true" aria-labelledby="signup-title">
    <div id="signup-modal">
      <button id="signup-close" aria-label="Close">×</button>
      <div class="eyebrow" id="signup-eyebrow">Join the squad</div>
      <h2 id="signup-title">Play the second half</h2>
      <p id="signup-text"></p>
      <div class="ml-embedded" data-form={SIGNUP_FORM}></div>
      <div id="signup-done">
        <p>You're in the squad. Enjoy the full demo!</p>
        <button class="btn-primary" id="signup-back">Back to the match</button>
      </div>
    </div>
  </div>
</Main>

<script>
  const MEMBER_COOKIE = 'tf_member';

  const COPY: Record<string, { eyebrow: string; title: string; text: string }> = {
    halftime: {
      eyebrow: 'Half-time',
      title: 'Play the second half',
      text: 'Join the squad to play on. It’s free, and you’ll unlock Chaos Cards and unlimited matches, plus Kickstarter launch news.',
    },
    replay: {
      eyebrow: 'Full-time',
      title: 'Fancy another match?',
      text: 'Join the squad for unlimited matches and Chaos Cards. Be the first to hear when the Kickstarter launches.',
    },
    chaos: {
      eyebrow: 'Chaos Cards',
      title: 'Unlock the chaos',
      text: 'VAR decisions, penalties, injuries and transfer drama. Join the squad to play with Chaos Cards.',
    },
  };

  const getCookie = (name: string) =>
    document.cookie.split('; ').find((c) => c.startsWith(`${name}=`))?.split('=')[1] ?? null;
  const setCookie = (name: string, value: string, days = 365) => {
    const expires = new Date(Date.now() + days * 864e5).toUTCString();
    document.cookie = `${name}=${encodeURIComponent(value)}; expires=${expires}; path=/; SameSite=Lax`;
  };

  const frame = document.getElementById('play') as HTMLIFrameElement;
  const modal = document.getElementById('signup')!;
  const done = document.getElementById('signup-done')!;
  let member = getCookie(MEMBER_COOKIE) === '1';

  // Members skip the gates; the demo also remembers sign-ups itself.
  frame.src = member ? '/play/?member=1' : '/play/';

  const tellDemo = (type: string) =>
    frame.contentWindow?.postMessage({ source: 'totally-football-site', type }, window.location.origin);

  function openSignup(reason: string) {
    if (member) {
      tellDemo('member');
      return;
    }
    const copy = COPY[reason] ?? COPY.replay;
    document.getElementById('signup-eyebrow')!.textContent = copy.eyebrow;
    document.getElementById('signup-title')!.textContent = copy.title;
    document.getElementById('signup-text')!.textContent = copy.text;
    modal.classList.add('show');
    track('demo_gate', { reason });
  }

  const closeSignup = () => modal.classList.remove('show');

  function track(name: string, params: Record<string, unknown> = {}) {
    const w = window as unknown as { gtag?: (...args: unknown[]) => void };
    if (typeof w.gtag === 'function') w.gtag('event', name, params);
  }

  function signedUp() {
    if (member) return;
    member = true;
    setCookie(MEMBER_COOKIE, '1');
    tellDemo('member');
    done.classList.add('show');
  }

  window.addEventListener('message', (e) => {
    if (e.origin !== window.location.origin || e.source !== frame.contentWindow) return;
    const data = e.data;
    if (data?.source !== 'totally-football-demo') return;
    if (data.type === 'gate') openSignup(data.reason);
    if (data.type === 'event') track(data.name, data.params);
  });

  document.getElementById('signup-close')!.addEventListener('click', closeSignup);
  document.getElementById('signup-back')!.addEventListener('click', closeSignup);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeSignup(); });

  // MailerLite swaps in a success message when the form submits.
  new MutationObserver(() => {
    const form = modal.querySelector('.ml-embedded');
    const success = form?.querySelector('.ml-form-successBody') as HTMLElement | null;
    const text = form?.textContent?.toLowerCase() ?? '';
    if ((success && getComputedStyle(success).display !== 'none') || text.includes('thanks for joining the squad')) signedUp();
  }).observe(modal, { childList: true, subtree: true, attributes: true, characterData: true });
</script>
