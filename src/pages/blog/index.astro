---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import Main from '../../layouts/Main.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Main title="Blog: Guides & Design Diaries | Totally Football" description="Guides, gift ideas and behind-the-scenes design diaries from Double Time Games, the makers of Totally Football." includeDiscoverMore={false} includeJoinTheSquad={true}>

<style>

	.date {
		margin-bottom: 20px;
	}

	section.hero {
		position: relative;
		display: flex; flex-direction: column; align-items: center; justify-content: center;
		text-align: center; padding: 20px; overflow: hidden;
	}

	.hero-title {
		font-family: 'Bebas Neue', sans-serif;
		font-size: clamp(2.4rem, 6vw, 3.8rem); letter-spacing: 0.05em;
		text-align: center; margin-bottom: 20px; line-height: 1;
	}

	section.content {
		width: 100%;
		margin: 0 auto;
		padding: 20px;
	}

	.intro {
		max-width: 720px;
		font-size: clamp(1rem, 2.5vw, 1.15rem);
		line-height: 1.65;
		color: var(--off-white);
	}

	.intro a {
		color: var(--lime);
	}

	section.content ul {
		list-style-type: none;
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 40px;
	}
	section.content ul li {
		width: 100%;
		background-color: var(--navy-mid);
		padding: 20px;
	}

	@media (min-width: 800px) {
		section.content ul li {
			max-width: 300px;
		}
	}

	section.content ul li img {
		width: 100%;
		height: auto;
	}

	section.content ul li a {
		color: var(--lime);
		text-decoration: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	section.content ul li a:hover {
		text-decoration: underline;
	}

	section.content ul li h4 {
		margin-bottom: 5px;
	}

</style>

<section class="hero">
	<h1 class="hero-title">The Totally Football Blog</h1>
	<p class="intro">
		Guides, gift ideas and design diaries from inside the making of <a href="/">Totally Football</a>.
		Looking for something to play? Start with our guide to the <a href="/blog/best-football-board-games-2026/">best football board games</a>.
		Want to see what we're building?
		<a href="/demo/">Play the free demo</a>.
	</p>
</section>

<section class="content">
	<ul>
		{
			posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						{post.data.heroImage && (
							<Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} />
						)}
						<h4 class="title">{post.data.title}</h4>
					</a>
					<p class="date">
						<FormattedDate date={post.data.pubDate} />
					</p>
				</li>
			))
		}
	</ul>
</section>
