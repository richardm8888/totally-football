---
import { Image } from 'astro:assets';
import KickstarterWords from '../../assets/ks-word.png';
import GameBoard from '../../assets/game-board-in-play.jpg';
import { kickstarterLink } from '../../consts';
---

<!-- HERO -->
<section class="hero">
    <div class="hero-left">
        <h1 class="hero-eyebrow">The tactical football board game</h1>
        <h2 class="hero-tagline">
            Draft your <span class="lime">squad.</span> <br />
            Win the <span class="lime">duels.</span> <br />
            Survive the <span class="lime">chaos.</span> 
        </h2>
        <div class="hero-cta-group">
            <a target="_blank" href={kickstarterLink('website_hero')} data-ks-location="hero" class="btn-kickstarter">
                Follow us on <Image src={KickstarterWords} alt="Kickstarter Banner" />
            </a>
            <a href="#signup" class="btn-primary">Join the squad</a>
        </div>
        <p class="hero-title">Get early access + exclusive Kickstarter rewards</p>
        <span class="hero-cta-note">Free to join · No spam ever</span>
    </div>

    <div class="hero-right">
        <Image
            src={GameBoard}
            alt="Totally Football football board game set up mid-match"
            widths={[600, 900, 1200, 1600]}
            sizes="(min-width: 800px) 650px, 120vw"
            loading="eager"
            fetchpriority="high"
        />

        
    </div>
</section>

<style>
    /* ── HERO ── */
    .hero {
        position: relative;
        display: flex; 
        flex-direction: column-reverse; 
        align-items: center; 
        justify-content: space-between;
        overflow: hidden;
        width: 100%;
    }

    .hero-left {
        overflow: hidden;
    }

    .hero-left, .hero-right {
        width: 100%;
        display: flex; 
        flex-direction: column; 
        align-items: center; 
        justify-content: center;
        padding: 20px; 
    }

    .hero-right {
        overflow-x: hidden;
        overflow-y: visible;
        padding-bottom: 40px;
    }

    .hero-right img {
        width: 120%;
        height: auto;
        transform: rotate(-10deg) translateX(-10px);
    } 

    .hero-eyebrow {
        font-family: 'Barlow Condensed', sans-serif; font-weight: 700;
        font-size: 1.2rem; letter-spacing: 0.24em; text-transform: uppercase;
        color: var(--lime); margin-bottom: 14px;
        text-align: center;
    }

    @media (min-width: 800px) {
        .hero-eyebrow { text-align: left; }
    }

    .hero-tagline {
        display: none;
        position: relative; 
        z-index: 2;
        font-family: 'Bebas Neue', sans-serif;
        font-size: 40px;
        text-align: center;
        letter-spacing: 0.06em; line-height: 0.95;
        margin-bottom: 20px;
        animation: fadeUp 0.7s 0.25s ease both;
    }

    @media (min-width: 800px) {
        .hero-tagline {
            display: block;
            font-size: 70px;
            text-align: left;
        }

        .hero {
            flex-direction: row; 
            padding-top: 40px;
        } 
        .hero-left, .hero-right {
            width: 50%;
            align-items: flex-start; 
            overflow: visible;
        }

        .hero-right img {
            width: 100%;
            transform: rotate(0deg) translateX(0px);
        }
    }

    .hero-title {
        margin: 10px 0;
        color: var(--off-white);
        font-size: 1.5rem;
        text-align: center;
    }
    .hero-sub {
        position: relative; z-index: 2;
        font-size: clamp(1rem, 2.5vw, 1.15rem); color: var(--text-muted);
        max-width: 600px; line-height: 1.65; margin-bottom: 48px;
        animation: fadeUp 0.7s 0.3s ease both;
    }
    .hero-cta-group {
        position: relative; 
        z-index: 2;
        display: flex; 
        flex-direction: row; 
        align-items: center; 
        gap: 12px;
        animation: fadeUp 0.7s 0.35s ease both;
    }

    .hero-cta-group a.btn-kickstarter, .hero-cta-group .btn-primary {
        width: 100%;
    }

    .hero-cta-group a.btn-kickstarter img {
        height: 24px;
        width: 212px;
    }
    .hero-cta-note { font-size: 1rem; color: var(--text-muted); letter-spacing: 0.06em; margin-bottom: 20px; }
    .scroll-hint {
        position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%);
        display: flex; flex-direction: column; align-items: center; gap: 6px;
        color: var(--text-muted); font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase;
        animation: bounce 2.2s infinite;
    }
    .scroll-hint svg { width: 16px; height: 16px; stroke: var(--lime); fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    @media (max-width: 1100px) {
        .hero-cta-group {
            flex-direction: column;
        }
    }
</style>
