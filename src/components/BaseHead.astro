---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import FallbackImage from '../assets/box-front.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage, type = 'website', noindex = false } = Astro.props;

// Share previews want roughly 1200px wide; the source art is far larger.
const shareImage = await getImage({ src: image, width: 1200, format: 'jpg' });
const shareImageURL = new URL(shareImage.src, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={shareImageURL} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={shareImageURL} />

<!-- Fonts -->
<!-- Loaded without blocking the first paint; text shows in a fallback font until these arrive. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:ital,wght@0,400;0,600;0,700;1,700&family=Barlow:wght@400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:ital,wght@0,400;0,600;0,700;1,700&family=Barlow:wght@400;500&display=swap" rel="stylesheet"></noscript>

<!-- MailerLite Universal -->
<script>
	(function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
	.push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
	n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
	(window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
	ml('account', '2070724');
</script>
<!-- End MailerLite Universal -->

{/* is:inline keeps these as written: bundling them would hide the global gtag() our events call. */}
{import.meta.env.PROD ? (
	<>
		<!-- Analytics: gtag() and dataLayer exist straight away so events queue, but the tag scripts
		     only download after the page has loaded, so they don't compete with the hero image. -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-CKPVZ0SWXW');
			dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});

			// Meta Pixel stub: fbq() calls queue until fbevents.js arrives.
			!function(f){if(f.fbq)return;var n=f.fbq=function(){n.callMethod?
			n.callMethod.apply(n,arguments):n.queue.push(arguments)};
			if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];}(window);
			fbq('init', '1159116853958516');
			fbq('track', 'PageView');
			fbq('track', 'ViewContent');

			(function () {
				function load(src) {
					var s = document.createElement('script'); s.async = true; s.src = src;
					document.head.appendChild(s);
				}
				function loadAll() {
					load('https://www.googletagmanager.com/gtm.js?id=GTM-MXQSJWNW');
					load('https://www.googletagmanager.com/gtag/js?id=G-CKPVZ0SWXW');
					load('https://connect.facebook.net/en_US/fbevents.js');
				}
				if (document.readyState === 'complete') loadAll();
				else window.addEventListener('load', loadAll, { once: true });
			})();
		</script>
		<noscript><img height="1" width="1" style="display:none"
		src="https://www.facebook.com/tr?id=1159116853958516&ev=PageView&noscript=1"
		/></noscript>
	</>
) : null}


<script>
	(function () {
		let leadTracked = false;

		function trackLead(formId) {
			if (leadTracked) return;

			if (typeof window.fbq === 'function') {
				window.fbq('track', 'Lead');
			}

			if (typeof window.gtag === 'function') {
				window.gtag('event', 'generate_lead', {
					form: 'mailerlite',
					form_id: formId || 'unknown'
				});
			}
				
			leadTracked = true;
		}

		function observeMailerLiteForm(form) {
			if (form.dataset.metaLeadObserver) return;
			form.dataset.metaLeadObserver = 'true';

			const container = form.closest('.ml-embedded') || form;
			const observer = new MutationObserver(function () {
				/*
				* MailerLite shows its success message when a submission succeeds. The
				* message is in the page from the start, just hidden, so check that it's
				* actually showing (not merely present) before counting a lead.
				*/
				const success = container.querySelector('.ml-form-successBody');
				if (success && success.getClientRects().length > 0) {
					trackLead(container.dataset ? container.dataset.form : undefined);
					// Signed up anywhere on the site: the demo's sign-up gates stay open.
					document.cookie = 'tf_squad=1; max-age=31536000; path=/; SameSite=Lax';
					observer.disconnect();
				}
			});

			observer.observe(container, {
				childList: true,
				subtree: true,
				characterData: true,
				attributes: true,
				attributeFilter: ['style', 'class']
			});
		}

		function findForms() {
			document.querySelectorAll('.ml-embedded').forEach(function (container) {
				const form = container.querySelector('form');

				if (form) {
					observeMailerLiteForm(form);
				}
			});
		}

		// MailerLite loads asynchronously, so watch for it appearing.
		const pageObserver = new MutationObserver(findForms);

		pageObserver.observe(document.body, {
			childList: true,
			subtree: true
		});

		// Also check immediately in case MailerLite has already loaded.
		findForms();

		// Kickstarter is where backers convert, so record every click out to it.
		document.addEventListener('click', function (event) {
			const link = event.target.closest && event.target.closest('a[href*="kickstarter.com"]');
			if (!link) return;

			const location = link.dataset.ksLocation || new URL(link.href).searchParams.get('ref') || 'unknown';

			if (typeof window.gtag === 'function') {
				window.gtag('event', 'click_kickstarter', {
					link_location: location,
					link_url: link.href
				});
			}

			if (typeof window.fbq === 'function') {
				window.fbq('trackCustom', 'KickstarterClick', { link_location: location });
			}
		});
	})();
</script>
