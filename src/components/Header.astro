---
import { Image } from 'astro:assets';
import LogoImage from '../assets/logo.svg';
import IconImage from '../assets/icon.svg';
import Navigation from './Navigation.astro';

const { kickstarterCta = false } = Astro.props;
---

<header>
    <div class="header-inner">
        <a href="/">
            <Image 
                class="header-logo" 
                src={LogoImage} 
                alt="Totally Football"
                height={"60"}
            />
            <Image 
                class="header-icon" 
                src={IconImage} 
                alt="Totally Football Icon"
                height={"40"}
            />
        </a>
        <Navigation kickstarterCta={kickstarterCta} />
    </div>
</header>

<style>
    header {
        width: 100%;
        position: fixed; 
        background-color: var(--navy-mid);
        height: 100px;
        z-index: 100;
        border-bottom: 2px solid var(--lime);
        display: flex;
        flex-direction: column;
        align-items: center;
    }
	header div.header-inner {
        width: 100%;
        max-width: 1300px;
        padding: 0 20px;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .header-logo {
        display: block;
    }

    .header-icon {
        display: none;
    }

    @media (max-width: 799px) {
        header {
            height: 60px; 
        }
        
        .header-logo {
            display: none;
        }

        .header-icon {
            display: block;
        }
    }
</style>
